# Copy this file to .env and adjust as needed.

# Path SQLite lokal (relatif ke root project)
DATABASE_URL="file:./dev.db"

# WAJIB diganti dengan string acak yang kuat sebelum dipakai di luar
# development (dipakai untuk menandatangani session cookie login).
# Generate dengan: openssl rand -hex 32
SESSION_SECRET="ganti-dengan-string-acak-yang-kuat"

# Port HTTP server
PORT=3000

# Opsional — hanya dibaca sekali saat `npm run seed` untuk membuat user
# admin pertama. Kalau tidak diisi, default: admin / admin123
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
