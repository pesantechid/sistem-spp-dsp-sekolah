<%- include('../partials/header') %>
<div class="page-header">
  <h1>Riwayat Surat</h1>
</div>

<div class="toolbar">
  <form method="get" action="/surat/riwayat" class="inline-form">
    <select name="periodeBulan" onchange="this.form.submit()">
      <option value="">Semua Periode</option>
      <% bulanLabels.forEach((label, i) => { %>
        <option value="<%= i + 1 %>" <%= periodeBulan === i + 1 ? 'selected' : '' %>><%= label %></option>
      <% }) %>
    </select>
  </form>
  <a href="/surat" class="btn secondary">+ Buat Surat</a>
</div>

<div class="panel" style="padding:0">
  <% if (list.length === 0) { %>
    <div class="empty-state">Belum ada surat yang dibuat.</div>
  <% } else { %>
  <table>
    <thead>
      <tr><th>No Surat</th><th>Nama Siswa</th><th>Kelas</th><th>Periode</th><th>Tanggal Dibuat</th><th>Dibuat Oleh</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% list.forEach(l => { %>
        <tr>
          <td><%= l.noSurat || '-' %></td>
          <td><a href="/siswa/<%= l.siswaId %>"><%= l.siswa.namaLengkap %></a></td>
          <td><%= l.kelasNama %></td>
          <td><%= bulanLabels[l.periodeBulan - 1] %></td>
          <td><%= new Date(l.tanggalDibuat).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></td>
          <td><%= l.dibuatOleh.nama %></td>
          <td><span class="badge <%= l.status === 'DRAFT' ? 'nonaktif' : 'aktif' %>"><%= l.status %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('../partials/footer') %>
