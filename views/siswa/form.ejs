<%- include('../partials/header') %>
<div class="page-header">
  <h1><%= title %></h1>
</div>

<div class="panel">
  <form class="stacked" method="post" action="<%= siswa ? `/siswa/${siswa.id}` : '/siswa' %>">
    <div class="field">
      <label for="namaLengkap">Nama Lengkap</label>
      <input type="text" id="namaLengkap" name="namaLengkap" value="<%= siswa ? siswa.namaLengkap : '' %>" required />
    </div>
    <div class="field-row">
      <div class="field">
        <label for="nis">NIS</label>
        <input type="text" id="nis" name="nis" value="<%= siswa && siswa.nis ? siswa.nis : '' %>" />
      </div>
      <div class="field">
        <label for="nisn">NISN</label>
        <input type="text" id="nisn" name="nisn" value="<%= siswa && siswa.nisn ? siswa.nisn : '' %>" />
      </div>
    </div>
    <div class="field">
      <label for="jenisKelamin">Jenis Kelamin</label>
      <select id="jenisKelamin" name="jenisKelamin">
        <option value="">-</option>
        <option value="L" <%= siswa && siswa.jenisKelamin === 'L' ? 'selected' : '' %>>Laki-laki</option>
        <option value="P" <%= siswa && siswa.jenisKelamin === 'P' ? 'selected' : '' %>>Perempuan</option>
      </select>
    </div>
    <div class="field">
      <label for="namaWali">Nama Wali/Orang Tua</label>
      <input type="text" id="namaWali" name="namaWali" value="<%= siswa && siswa.namaWali ? siswa.namaWali : '' %>" />
    </div>
    <div class="field-row">
      <div class="field">
        <label for="noHpWali">No. HP Wali</label>
        <input type="text" id="noHpWali" name="noHpWali" value="<%= siswa && siswa.noHpWali ? siswa.noHpWali : '' %>" />
      </div>
      <div class="field">
        <label for="emailWali">Email Wali</label>
        <input type="email" id="emailWali" name="emailWali" value="<%= siswa && siswa.emailWali ? siswa.emailWali : '' %>" />
      </div>
    </div>

    <% if (!siswa) { %>
      <hr class="sep" />
      <div class="field">
        <label for="kelasId">Kelas (<%= tahunAjaranAktif.label %>)</label>
        <select id="kelasId" name="kelasId" required>
          <% kelasList.forEach(k => { %>
            <option value="<%= k.id %>"><%= k.jenjang.nama %> - <%= k.nama %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="bulanMulai">Mulai Ditagih Bulan Ke- (1=Juli ... 12=Juni)</label>
        <input type="number" id="bulanMulai" name="bulanMulai" min="1" max="12" value="1" />
      </div>
      <hr class="sep" />
      <div class="field-row">
        <div class="field">
          <label for="saldoAwalSpp">Tunggakan SPP Awal (Rp, jika ada)</label>
          <input type="number" id="saldoAwalSpp" name="saldoAwalSpp" min="0" step="1000" value="0" />
        </div>
        <div class="field">
          <label for="jumlahDsp">Tagihan DSP (Rp, jika ada)</label>
          <input type="number" id="jumlahDsp" name="jumlahDsp" min="0" step="1000" value="<%= typeof pengaturan !== 'undefined' && pengaturan ? pengaturan.dspStandar : 0 %>" />
        </div>
      </div>
    <% } else { %>
      <hr class="sep" />
      <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="AKTIF" <%= siswa.status === 'AKTIF' ? 'selected' : '' %>>Aktif</option>
          <option value="LULUS" <%= siswa.status === 'LULUS' ? 'selected' : '' %>>Lulus</option>
          <option value="PINDAH" <%= siswa.status === 'PINDAH' ? 'selected' : '' %>>Pindah</option>
          <option value="KELUAR" <%= siswa.status === 'KELUAR' ? 'selected' : '' %>>Keluar</option>
        </select>
      </div>
    <% } %>

    <div class="form-actions">
      <button type="submit" class="btn">Simpan</button>
      <a href="/siswa" class="btn secondary">Batal</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
